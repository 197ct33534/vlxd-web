		-
			message: "#^Method App\\\\Http\\\\Controllers\\\\PriceHistoryController\\:\\:buildSummaries\\(\\) should return Illuminate\\\\Support\\\\Collection\\<int, object\\> but returns Illuminate\\\\Support\\\\Collection\\<int, object\\{product_name\\: string, unit\\: string, line_count\\: int, latest_price\\: float, latest_date\\: mixed, latest_invoice_id\\: mixed, latest_invoice_code\\: mixed, has_variation\\: bool, delta_vs_previous\\: float\\|null, direction\\: string\\|null, abs_change\\: float\\|null\\}&stdClass\\>\\.$#"
			count: 1
			path: app/Http/Controllers/PriceHistoryController.php

		-
			message: "#^Parameter \\#1 \\$grouped of method App\\\\Http\\\\Controllers\\\\PriceHistoryController\\:\\:buildSummaries\\(\\) expects Illuminate\\\\Support\\\\Collection\\<string, Illuminate\\\\Support\\\\Collection\\<int, object\\>\\>, Illuminate\\\\Support\\\\Collection\\<string, Illuminate\\\\Support\\\\Collection\\<int, stdClass\\>\\> given\\.$#"
			count: 1
			path: app/Http/Controllers/PriceHistoryController.php

		-
			message: "#^Relation 'customer' is not found in App\\\\Models\\\\Project model\\.$#"
			count: 1
