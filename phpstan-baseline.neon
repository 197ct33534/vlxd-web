		-
			message: "#^Relation 'projects' is not found in App\\\\Models\\\\Customer model\\.$#"
			count: 2
			path: app/Http/Controllers/CustomerController.php

		-
			message: "#^Relation 'user' is not found in App\\\\Models\\\\DailyReport model\\.$#"
			count: 1
			path: app/Http/Controllers/DailyReportController.php

		-
			message: "#^If condition is always true\\.$#"
			count: 1
			path: app/Http/Controllers/ImportInvoiceController.php

		-
			message: "#^Unreachable statement \\- code above always terminates\\.$#"
			count: 1
			path: app/Http/Controllers/ImportInvoiceController.php

		-
			message: "#^Access to an undefined property App\\\\Models\\\\Invoice\\:\\:\\$project\\.$#"
			count: 3
