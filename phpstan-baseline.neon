		-
			message: "#^Relation 'customer' is not found in App\\\\Models\\\\Project model\\.$#"
			count: 3
			path: app/Http/Controllers/AdminReportController.php

		-
			message: "#^Call to an undefined method Laravel\\\\Sanctum\\\\Contracts\\\\HasAbilities\\:\\:delete\\(\\)\\.$#"
			count: 1
			path: app/Http/Controllers/Api/AuthTokenController.php

		-
			message: "#^Using nullsafe method call on non\\-nullable type Laravel\\\\Sanctum\\\\Contracts\\\\HasAbilities\\. Use \\-\\> instead\\.$#"
